<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A001A"
    android:padding="16dp">

    <!-- Header with back button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="12dp">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_back"
            android:contentDescription="@string/back"
            android:theme="@style/Theme.CryptidScholar.NoActionBar"
            app:tint="#F1C40F"/>

        <TextView
            android:id="@+id/detailTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#F1C40F"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:maxLines="1"/>

    </LinearLayout>

    <!-- Image card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="#140028"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp">

        <ImageView
            android:id="@+id/cryptidImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@string/cryptid_image"
            android:background="#0A001A"/>

    </com.google.android.material.card.MaterialCardView>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Type badge -->
            <TextView
                android:id="@+id/typeBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:background="#625FA6"
                android:textAllCaps="true"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <!-- Location -->
            <TextView
                android:id="@+id/locationText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#625FA6"
                android:textSize="14sp"
                android:drawableStart="@android:drawable/ic_menu_myplaces"
                android:drawablePadding="6dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp"/>

            <!-- Other names -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Other Names"
                android:textColor="#625FA6"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/otherNamesText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#C0C0D0"
                android:textSize="14sp"
                android:layout_marginBottom="16dp"/>

            <!-- Description -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Description"
                android:textColor="#F1C40F"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp"/>

            <TextView
                android:id="@+id/descriptionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#C0C0D0"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.3"
                android:layout_marginBottom="16dp"/>

            <!-- Fact -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Did You Know?"
                android:textColor="#F1C40F"
                android:textSize="14sp"
                android:textStyle="bold"
                android:drawableStart="@android:drawable/ic_menu_agenda"
                android:drawablePadding="6dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp"/>

            <TextView
                android:id="@+id/factText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#E8E8F0"
                android:textSize="13sp"
                android:lineSpacingMultiplier="1.3"
                android:layout_marginBottom="16dp"/>

            <!-- Tips -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Look For"
                android:textColor="#F1C40F"
                android:textSize="14sp"
                android:textStyle="bold"
                android:drawableStart="@android:drawable/ic_menu_search"
                android:drawablePadding="6dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp"/>

            <TextView
                android:id="@+id/tipsText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#E8E8F0"
                android:textSize="13sp"
                android:lineSpacingMultiplier="1.3"
                android:layout_marginBottom="16dp"/>

            <!-- Source link -->
            <TextView
                android:id="@+id/sourceLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Source"
                android:textColor="#625FA6"
                android:textSize="11sp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="2dp"/>

            <TextView
                android:id="@+id/sourceUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#625FA6"
                android:textSize="12sp"
                android:autoLink="web"
                android:linksClickable="true"/>

        </LinearLayout>

    </ScrollView>

    <!-- Load error / empty state -->
    <TextView
        android:id="@+id/emptyState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cannot load cryptid details"
        android:textColor="#625FA6"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginTop="16dp"
        android:visibility="gone"/>

</LinearLayout>
